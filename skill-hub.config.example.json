{
  "$comment": "建議用 skill-hub init 產生設定檔；也可以複製成 skill-hub.config.json 手動修改（該檔不進版控）。路徑可用 ~ 代表家目錄。",
  "sources": [
    { "name": "my-skills", "path": "~/dev/skills" }
  ],
  "usage": {
    "claudeCode": { "enabled": true, "dir": "~/.claude/projects" },
    "codex": { "enabled": true, "dir": "~/.codex/sessions" },
    "imports": [
      { "platform": "grok-bot", "file": "usage/grok-bot.jsonl" }
    ]
  },
  "categories": {
    "行銷": ["meeting-notes"],
    "開發": ["release-checklist"]
  },
  "projects": {
    "roots": [],
    "aliases": { "my-shop-v2": "my-shop" }
  },
  "securityReviews": "data/security-reviews.json",
  "checks": {
    "unusedDays": 60,
    "descriptionMax": 1024,
    "bodyMaxLines": 500,
    "remote": false
  },
  "outDir": "out"
}
